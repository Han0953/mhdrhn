# Copy to .env.local and enter your key there. Keep API keys server-only.
# Used by the server route /api/azura. Never use a NEXT_PUBLIC_ key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only Firestore credentials, required in production. Never NEXT_PUBLIC_.
# Use the same Firebase project and salt across deployments sharing the Gemini quota.
FIREBASE_PROJECT_ID=mhdrhn-2a49b
FIREBASE_CLIENT_EMAIL=
# Service account PEM, with newlines represented as \n inside a quoted .env value.
FIREBASE_PRIVATE_KEY=
# Local default is bounded memory; set firestore explicitly to test the real connection.
AZURA_LIMITER_MODE=memory
# Generate a random secret of at least 32 characters; store only in server environment.
AZURA_RATE_LIMIT_SALT=
# Safe production counters/status/latency logs, no messages or IPs. Set 0 to disable.
AZURA_LOG_EVENTS=1
